# Video Cleaner local server
PORT=3001

# Required for ElevenLabs Scribe transcription.
# Keep this server-side. Never prefix it with VITE_.
ELEVENLABS_API_KEY=

# Default B-roll image provider: gemini | grok-cli | codex-cli | openai
IMAGE_PROVIDER=gemini

# Gemini API image generation (stable provider option)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# OpenAI Images API (optional provider)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Grok Build CLI image/video provider (experimental).
# Leave GROK_BIN blank to auto-detect `grok` from PATH.
# GROK_IMAGE_MODEL can be blank to use the CLI default agent model.
# GROK_VIDEO_MODEL is the preferred Imagine image-to-video model used in the Grok task prompt.
GROK_BIN=
GROK_IMAGE_MODEL=
GROK_VIDEO_MODEL=grok-imagine-video-1.5

# Google Flow video provider via the unofficial gflow-cli browser automation.
# Install: uv tool install gflow-cli
# Login once: gflow auth login --browser chrome
# Leave GFLOW_BIN blank to auto-detect `gflow` from PATH.
GFLOW_BIN=
GFLOW_PROFILE=
GFLOW_VIDEO_MODEL=veo-fast

# Magnific API video provider.
# API key: Magnific dashboard -> Settings -> Organization -> API Keys.
# Defaults to MiniMax Hailuo 2.3 768p Fast, 6-second image-to-video clips.
MAGNIFIC_API_KEY=
MAGNIFIC_VIDEO_MODEL=minimax-hailuo-2-3-768p-fast
# Optional endpoint override for a custom/future Magnific route. The old
# api.freepik.com/.../minimax-h3-max-turbo value is migrated automatically.
MAGNIFIC_VIDEO_ENDPOINT=

# Codex CLI is required for dialogue cleanup, B-roll scene planning, and B-roll video motion prompts.
# It can also generate B-roll stills directly with Codex built-in $imagegen.
CODEX_BIN=
CODEX_IMAGE_QUALITY=high

# Optional local presenter-cutout templates.
# Install Python dependencies with:
#   python3 -m pip install -r requirements-matting.txt
# Leave PYTHON_BIN blank to auto-detect python3/python from PATH.
PYTHON_BIN=
# Only needed for MediaPipe Tasks-only installations that do not expose mp.solutions.
# Point this at a local selfie_segmenter.tflite model if required.
MEDIAPIPE_SELFIE_MODEL=

# Local media binaries. Leave blank to auto-detect from PATH.
FFMPEG_BIN=
FFPROBE_BIN=

# Optional working-project directory. The original master video is never copied here.
# PROJECTS_DIR=/Users/you/VideoCleaner/projects
PROJECTS_DIR=
