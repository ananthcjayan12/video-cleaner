# Video Cleaner local server
PORT=3001

# Required for ElevenLabs Scribe transcription.
# Keep this server-side. Never prefix it with VITE_.
ELEVENLABS_API_KEY=

# Required only for hyper-realistic B-roll image generation.
# Codex CLI login is used for scene planning, but the Images API needs an API key.
# Keep this server-side. Never prefix it with VITE_.
OPENAI_API_KEY=

# Optional. GPT Image 2 is the recommended/default image model.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional binary overrides. Leave blank to auto-detect from PATH.
CODEX_BIN=
FFMPEG_BIN=
FFPROBE_BIN=

# Optional working-project directory. The original master video is never copied here.
# PROJECTS_DIR=/Users/you/VideoCleaner/projects
PROJECTS_DIR=
