# Video Cleaner local server
PORT=3001

# Required for ElevenLabs Scribe transcription.
# Keep this server-side. Never prefix it with VITE_.
ELEVENLABS_API_KEY=

# Default B-roll image provider: gemini | grok-cli | codex-cli | openai
IMAGE_PROVIDER=gemini

# Gemini API image generation (stable provider option)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# OpenAI Images API (optional provider)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Grok Build CLI image/video provider (experimental).
# Leave GROK_BIN blank to auto-detect `grok` from PATH.
# GROK_IMAGE_MODEL can be blank to use the CLI default agent model.
# GROK_VIDEO_MODEL is the preferred Imagine image-to-video model used in the Grok task prompt.
GROK_BIN=
GROK_IMAGE_MODEL=
GROK_VIDEO_MODEL=grok-imagine-video-1.5

# Codex CLI is required for dialogue cleanup, B-roll scene planning, and B-roll video motion prompts.
# When IMAGE_PROVIDER=codex-cli, image generation uses Codex built-in `$imagegen` directly.
# The app runs each image job in an isolated git-backed workspace and removes OPENAI_API_KEY /
# CODEX_API_KEY from that child process so it uses the authenticated Codex CLI session.
# CODEX_IMAGE_QUALITY accepts: medium | high (default: high).
CODEX_BIN=
CODEX_IMAGE_QUALITY=high

# Local media binaries. Leave blank to auto-detect from PATH.
FFMPEG_BIN=
FFPROBE_BIN=

# Optional working-project directory. The original master video is never copied here.
# PROJECTS_DIR=/Users/you/VideoCleaner/projects
PROJECTS_DIR=
